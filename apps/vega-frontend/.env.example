# ============================
# Vega Frontend .env.example
# ============================
# Next.js public env vars must be prefixed with NEXT_PUBLIC_

# --- API Base URL ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Supabase) ---
DATABASE_URL=postgresql://user:password@host:port/vega_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare R2 ---
CLOUDFLARE_R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET_NAME=vega-assets
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-account.r2.dev

# --- Email (Resend) ---
RESEND_API_KEY=re_your_api_key

# --- WhatsApp ---
WHATSAPP_NUMBER=971567351095

# --- Auth ---
JWT_SECRET=your-super-secret-jwt-key
ADMIN_SECRET=your-admin-secret

# --- Google Reviews ---
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_PLACE_ID=your-google-place-id

# --- App URLs ---
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001
